{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  },
  "outputDirectory": "dist",
  "functions": {
    "api/admin.js": {
      "includeFiles": "server/admin-*.html",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/admin/",
      "destination": "/api/admin"
    }
  ]
}
