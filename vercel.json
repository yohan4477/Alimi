{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  },
  "outputDirectory": "dist",
  "functions": {
    "api/admin.js": {
      "includeFiles": "server/admin-*.html",
      "maxDuration": 30
    },
    "api/owned-poll.js": {"includeFiles":"server/owned-poll-catalog.json","maxDuration":30},
    "api/beauty-play.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/beauty-play/api/:route",
      "destination": "/api/beauty-play?route=:route"
    },
    {
      "source": "/beauty-play",
      "destination": "/beauty-play/index.html"
    },
    {
      "source": "/beauty-play/",
      "destination": "/beauty-play/index.html"
    },
    {
      "source": "/admin",
      "destination": "/api/admin"
    },
    {
      "source": "/admin/",
      "destination": "/api/admin"
    },
    {
      "source": "/kr",
      "destination": "/index.html"
    },
    {
      "source": "/kr/",
      "destination": "/index.html"
    },
    {
      "source": "/us",
      "destination": "/index.html"
    },
    {
      "source": "/us/",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/terms.html"
    }
  ]
}
